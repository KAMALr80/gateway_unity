APP_NAME=Gateway
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.yourdomain.com
# Storefront origin, no trailing slash: customer password-reset emails link to FRONTEND_URL/reset-password.
FRONTEND_URL=https://www.yourdomain.com
# Same value as REVALIDATE_SECRET on the storefront: lets homepage edits show up there immediately (empty = off).
FRONTEND_REVALIDATE_SECRET=

# Middleware's own database
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=gateway
DB_USERNAME=root
DB_PASSWORD=

# ERP's database (shared, read for nothing — ERP writes to us directly)
DB_ERP_HOST=127.0.0.1
DB_ERP_PORT=3306
DB_ERP_DATABASE=erp_db
DB_ERP_USERNAME=erp_readonly_user  # give only SELECT if you ever need to read
DB_ERP_PASSWORD=another_strong_password

# Redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# CACHE_DRIVER=redis
# QUEUE_CONNECTION=redis
# SESSION_DRIVER=redis

# CORS: comma-separated storefront origins allowed to call /api (unset = any origin)
# e.g. CORS_ALLOWED_ORIGINS=https://storefront.example.com  (local: http://localhost:3000,http://127.0.0.1:3000)
CORS_ALLOWED_ORIGINS=

# Product image WebP variants (config/media.php); only images on these hosts are fetched and resized
MEDIA_THUMBNAILS_ENABLED=true
MEDIA_THUMBNAIL_SOURCE_HOSTS=erp.unitywholesales.com

# JWT
JWT_SECRET=                     # filled by php artisan jwt:secret
JWT_TTL=1440                    # 24 hours in minutes
JWT_REFRESH_TTL=20160           # 14 days

# ERP order webhook (the existing URL your ERP exposes)
ERP_ORDER_WEBHOOK_URL=https://your-erp-domain.com/api/orders/receive
ERP_WEBHOOK_SECRET=shared_secret_for_hmac

# Internal API security (ERP uses this key when calling middleware)
INTERNAL_API_KEY=long_random_secret_for_erp_sync_calls